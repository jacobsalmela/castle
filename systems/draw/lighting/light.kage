//kage:unit pixels

package main

// Configurable parameters (passed as uniforms from config)
var LightPosSize vec3
var LightIntensity float      // Brightness multiplier (1.0 = normal, 2.0 = twice as bright)
var Time float
var AmbientBrightness float   // Minimum light level (0.0 = pitch black, 1.0 = fully lit)
var FlickerAmount float       // 0.0 = no flicker, 0.4 = strong candle-like (default from upstream)
var FlickerSpeed float        // Swing speed for torch movement (1.5 Hz default)
var LightResolution float     // Posterization bands (8.0 = upstream, lower = more bands)
var LightResolutionOffset float // Offset for band positioning (0.8 = upstream)
var DitherIntensity float     // Random noise/grain intensity (0.04 = upstream)

// Random function for dithering and flicker
// https://gist.github.com/patriciogonzalezvivo/670c22f3966e662d2f83
func rand(co vec2) float {
	return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Calculate light direction and distance from pixel to light source
	// Coordinates are screen-space (camera-adjusted), dstPos.xy is pixel position in buffer
	lightVec := LightPosSize - vec3(dstPos.xy, 0)
	lightDir := normalize(lightVec)
	distance := length(lightVec.xy)
	
	// Distance attenuation: light fades based on distance from center
	// Use the light size (LightPosSize.z) as the radius
	attenuation := clamp(1.0 - (distance / LightPosSize.z), 0.0, 1.0)

	// Sample normal map
	normalValues := imageSrc0At(srcPos).xyzw
	normalColor := normalValues.xyz
	normalColor.y = 1 - normalColor.y  // Flip Y for correct orientation
	normal := normalize(normalColor*2 - 1)

	// Use ambient brightness from config (0.0 = pitch black, 1.0 = fully lit)
	ambientLight := AmbientBrightness

	// Diffuse lighting with normal map, modulated by distance attenuation and intensity
	diffuse := (1 - ambientLight) * max(dot(normal, lightDir * 0.1), 0.0) * attenuation * LightIntensity

	// Add organic torch swing (slow cosine wave) and random flicker
	diffuse += (cos(FlickerSpeed*Time) + ((rand(vec2(Time)) - 0.5) * FlickerAmount)) * 0.01

	// Add dithering/grain texture for retro look
	diffuse *= 1 + DitherIntensity*(rand(srcPos)-0.5)

	// Posterize into discrete bands (pixel art style)
	diffuse = floor(LightResolution*diffuse+LightResolutionOffset) / LightResolution

	// Clamp and add ambient
	diffuse = clamp(diffuse+ambientLight, 0, 1)

	// Add unlit areas (alpha channel from normal map)
	diffuse += 1 - normalValues.w

	return vec4(diffuse, diffuse, diffuse, 1)
}
